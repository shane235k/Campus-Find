# ==============================================================================
# Campus Lost & Found Hub — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific values.
# NEVER commit the active '.env' file containing secrets to version control.
# ==============================================================================

# Django Core Settings
DEBUG=True
SECRET_KEY=replace-with-a-secure-random-secret-key-for-local-development
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database Settings (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database_name]
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/campus_lost_found

# Individual Database Parameters (fallback if DATABASE_URL is unset)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=campus_lost_found
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
CONN_MAX_AGE=600

# Localization
TIME_ZONE=Asia/Kolkata
LANGUAGE_CODE=en-us
